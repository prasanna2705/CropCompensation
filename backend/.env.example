PORT=4000
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agrishield

# Auth
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Blockchain
RPC_URL=http://127.0.0.1:8545
POLICY_MANAGER_ADDRESS=
ORACLE_AGGREGATOR_ADDRESS=

# Only needed if the backend itself relays oracle-signed readings on behalf of the oracle service.
ORACLE_RELAY_PRIVATE_KEY=

# Only needed if the backend relays admin transactions server-side instead of the admin signing directly in-browser.
ADMIN_RELAY_PRIVATE_KEY=
